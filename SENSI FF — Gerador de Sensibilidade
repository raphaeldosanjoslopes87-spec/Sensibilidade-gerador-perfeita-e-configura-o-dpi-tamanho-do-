<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090909">
  <meta name="description" content="Gerador de sensibilidade equilibrada para Free Fire. Escolha seu celular e gere sua configuração.">

  <title>SENSI FF — Gerador de Sensibilidade</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top, #260000 0%, #0b0000 35%, #050505 75%);
      color: white;
    }

    .container {
      width: 92%;
      max-width: 900px;
      margin: auto;
      padding: 25px 0 50px;
    }

    header {
      text-align: center;
      padding: 25px 10px;
    }

    .logo {
      font-size: 42px;
      font-weight: 900;
      color: #ff2020;
      text-shadow:
        0 0 10px #ff0000,
        0 0 25px #ff0000;
      letter-spacing: 2px;
    }

    .subtitle {
      margin-top: 8px;
      color: #aaa;
      font-size: 15px;
    }

    .card {
      background: rgba(15, 15, 15, 0.96);
      border: 1px solid #3b1111;
      border-radius: 18px;
      padding: 22px;
      margin-top: 20px;
      box-shadow: 0 0 25px rgba(255, 0, 0, 0.12);
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #ddd;
      font-weight: bold;
    }

    select {
      width: 100%;
      padding: 15px;
      border-radius: 12px;
      border: 1px solid #4a1818;
      background: #111;
      color: white;
      font-size: 16px;
      outline: none;
    }

    select:focus {
      border-color: #ff2020;
    }

    .generate {
      width: 100%;
      margin-top: 20px;
      padding: 17px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(90deg, #b40000, #ff2020);
      color: white;
      font-size: 17px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 0 18px rgba(255, 0, 0, 0.35);
      transition: 0.2s;
    }

    .generate:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 28px rgba(255, 0, 0, 0.55);
    }

    .result {
      display: none;
    }

    .device-title {
      text-align: center;
      color: #ff3333;
      font-size: 22px;
      margin-bottom: 5px;
    }

    .profile {
      text-align: center;
      color: #999;
      margin-bottom: 20px;
    }

    .settings {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .setting {
      background: #0b0b0b;
      border: 1px solid #2d2d2d;
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }

    .setting-name {
      display: block;
      color: #aaa;
      font-size: 13px;
      margin-bottom: 7px;
    }

    .setting-value {
      color: #ff2929;
      font-size: 25px;
      font-weight: 900;
    }

    .highlight {
      border-color: #7d1111;
      box-shadow: inset 0 0 15px rgba(255, 0, 0, 0.06);
    }

    .copy {
      width: 100%;
      padding: 15px;
      margin-top: 18px;
      border-radius: 12px;
      border: 1px solid #4d1717;
      background: #160606;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    .copy:hover {
      background: #260909;
    }

    .info {
      margin-top: 20px;
      padding: 15px;
      border-radius: 12px;
      background: #0b0b0b;
      border-left: 4px solid #ff2020;
      color: #aaa;
      font-size: 13px;
      line-height: 1.6;
    }

    footer {
      text-align: center;
      color: #666;
      font-size: 12px;
      margin-top: 30px;
    }

    @media (max-width: 600px) {
      .logo {
        font-size: 32px;
      }

      .settings {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 17px;
      }
    }
  </style>
</head>

